+// Sorting destructively subtracts each field minimum from the merger keys.
+// Observe, but NEVER modify, those keys or the legacy source-splice registry.
+inline void record_sort_shift(int element, int bucket_index, int minimum) noexcept {
+    if (!state.collecting) return;
+    if (!valid_element(element) || bucket_index < 0 || bucket_index >= 4) {
+        fail("Invalid source-VID sorting shift."); return;
+    }
+    const unsigned char bit = static_cast<unsigned char>(1u << bucket_index);
+    if (state.sort_passes[element] & bit) {
+        fail("A source-VID sorting pass was observed twice."); return;
+    }
+    // bucket passes are group0, node0, group1, node1.
+    state.source_vid_shifts[element][bucket_index ^ 1] = minimum;
+    state.sort_passes[element] |= bit;
+}
